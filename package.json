{
  "name": "worktree-flow",
  "version": "0.1.0",
  "description": "Manage git worktrees across a poly-repo environment",
  "type": "module",
  "bin": {
    "flow": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "npm run build",
    "validate": "npm run type-check && npm run test && npm run build"
  },
  "keywords": [
    "git",
    "worktree",
    "monorepo",
    "polyrepo",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/checkbox": "^5.0.4",
    "@inquirer/confirm": "^6.0.4",
    "@inquirer/input": "^5.0.4",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/sinon": "^21.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "memfs": "^4.56.10",
    "sinon": "^21.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
